# Gemini API Key (get from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Claude API Key (get from https://console.anthropic.com/)
CLAUDE_API_KEY=your_claude_api_key_here

# MCP Server Configuration - Use HTTP mode
MCP_SERVER_URL=http://localhost:8080

# CORS Settings (frontend URL)
FRONTEND_URL=http://localhost:5173

# LLM Provider Selection ("gemini" or "claude")
# chat_llm_provider: Used for /chat endpoint conversations
# analysis_llm_provider: Used for match analysis sub-agents
CHAT_LLM_PROVIDER=gemini
ANALYSIS_LLM_PROVIDER=claude
